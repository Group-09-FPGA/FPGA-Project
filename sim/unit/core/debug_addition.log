# 1. Generate Hex Files
make clean -C ./mem_generator
make[1]: Entering directory '/home/ronit/acad/sem-3/hardware/fpga-lob/sim/unit/core/mem_generator'
rm -f code.elf ./imem_dmem/imem.bin ./imem_dmem/imem.hex ./imem_dmem/dmem.bin ./imem_dmem/dmem.hex ./imem_dmem/code.dis
make[1]: Leaving directory '/home/ronit/acad/sem-3/hardware/fpga-lob/sim/unit/core/mem_generator'
make addition -C ./mem_generator
make[1]: Entering directory '/home/ronit/acad/sem-3/hardware/fpga-lob/sim/unit/core/mem_generator'
/tools/Xilinx/2026.1/gnu/riscv/lin/bin/riscv64-unknown-elf-gcc -c  code_addition.c -o code.elf -march=rv32i -mabi=ilp32
/tools/Xilinx/2026.1/gnu/riscv/lin/bin/riscv64-unknown-elf-objcopy -O binary code.elf ./imem_dmem/imem.bin
/tools/Xilinx/2026.1/gnu/riscv/lin/bin/riscv64-unknown-elf-objcopy -j .data -O binary code.elf ./imem_dmem/dmem.bin
/tools/Xilinx/2026.1/gnu/riscv/lin/bin/riscv64-unknown-elf-objdump -d code.elf > ./imem_dmem/code.dis
cd imem_dmem && python3 bin2hex.py
make[1]: Leaving directory '/home/ronit/acad/sem-3/hardware/fpga-lob/sim/unit/core/mem_generator'
ln -sf ./mem_generator/imem_dmem/imem.hex . && ln -sf ./mem_generator/imem_dmem/dmem.hex .
